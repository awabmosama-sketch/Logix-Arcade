<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #111111;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oopprojectjavafx.snake_game.LeaderboardsController">
   <children>
      <HBox alignment="CENTER" spacing="50.0">
         <children>
            <VBox alignment="CENTER" spacing="15.0">
               <children>
                  <Label style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-background-radius: 8; -fx-border-radius: 8;" text="LeaderBoards" textFill="WHITE">
                     <font>
                        <Font size="36.0" />
                     </font>
                  </Label>
                  <ListView fx:id="listView" prefHeight="346.0" prefWidth="250.0" style="-fx-background-color: #1a1a1a; -fx-control-inner-background: #1a1a1a; -fx-text-fill: white; -fx-border-color: #333333; -fx-background-radius: 5; -fx-border-radius: 5;" styleClass=".list-cell {    -fx-text-fill: white;    -fx-font-weight: bold;}" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="402.0" prefWidth="341.0" spacing="20.0">
               <children>
                  <Label text="Congrats" textFill="#00ff66">
                     <font>
                        <Font name="System Bold" size="36.0" />
                     </font>
                  </Label>
                  <Label text="Please write you name to submit score" textFill="#aaaaaa">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label text="SCORE : " textFill="#00ff66">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="label3" text="00" textFill="#00ff66">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="textField" style="-fx-text-fill: white; -fx-background-color: #222222; -fx-border-color: #333333; -fx-border-radius: 5; -fx-background-radius: 5;" styleClass="t" />
                  <Button mnemonicParsing="false" onAction="#handleSubmit" style="-fx-background-color: #00ff66; -fx-text-fill: #111111; -fx-cursor: hand;" text="Submit">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#playAgain" prefHeight="26.0" prefWidth="153.0" style="-fx-background-color: #00ff66; -fx-text-fill: #111111; -fx-cursor: hand;" text="PLAY AGAIN">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</StackPane>
