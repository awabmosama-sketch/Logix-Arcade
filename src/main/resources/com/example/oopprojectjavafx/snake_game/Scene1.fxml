<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oopprojectjavafx.snake_game.SnakeController">
   <children>
      <HBox alignment="CENTER" onKeyPressed="#keyPress" prefHeight="48.0" spacing="200.0" style="-fx-background-color: #1a1a1a;">
         <children>
            <Button fx:id="startbutton" mnemonicParsing="false" onAction="#startButton" style="-fx-background-color: #00ff66; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 5;" text="Start" />
            <Label fx:id="scorelabel" style="-fx-text-fill: #ffffff; -fx-font-family: 'Courier New'; -fx-font-weight: bold;" text="SCORE: 0">
               <font>
                  <Font size="18.0" />
               </font></Label>
         </children>
      </HBox>
      <Pane fx:id="gamePane" style="-fx-background-color: #252525; -fx-border-color: #333333; -fx-border-image-width: 2;" VBox.vgrow="ALWAYS" />
   </children>
</VBox>
